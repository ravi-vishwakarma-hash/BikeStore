{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "Host": "your-redis-host",
    "Port": 6379,
    "User": "default",
    "Password": "your-redis-password"
  },
  "ConnectionStrings": {
    "bike_store_db": "your-database-connection-string"
  },
  "OpenTelemetry": {
    "ServiceName": "MyApi",
    "OtlpEndpoint": "http://localhost:4317"
  }
}
